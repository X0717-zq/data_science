{
  "output": "credit_card_fraud_10k_results/nn_rf_comparison",
  "input": "fraudulent_card.csv",
  "frozen_splits": "credit_card_fraud_10k_results/chapter6_supplement/learning_curves/frozen_training_subsets.json",
  "hidden_layers": [64, 32],
  "activation": "ReLU",
  "dropout": 0.1,
  "optimizer": "AdamW",
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 256,
  "max_epochs": 400,
  "min_epochs": 60,
  "early_stopping_patience": 50,
  "selection_metric": "validation_pr_auc",
  "improvement_tolerance": 1e-12,
  "checkpoint_tie_break": "earliest_epoch",
  "threshold_metric": "validation_f2",
  "threshold_tie_break": "larger_threshold",
  "num_threads": 1,
  "sampling_ratio": 0.5,
  "smote_neighbors": 5,
  "nearmiss_neighbors": 3,
  "variants": [
    {"method": "MLP-Plain", "strategy": "none", "rf_method": "RF-Plain"},
    {"method": "MLP-Balanced", "strategy": "balanced", "rf_method": "RF-Balanced"},
    {"method": "MLP-SMOTE", "strategy": "SMOTE", "rf_method": "SMOTE"},
    {"method": "MLP-ADASYN", "strategy": "ADASYN", "rf_method": "ADASYN"},
    {"method": "MLP-NearMiss", "strategy": "NearMiss", "rf_method": "NearMiss"},
    {"method": "MLP-SMOTE+Tomek", "strategy": "SMOTE+Tomek", "rf_method": "SMOTE+Tomek"},
    {"method": "MLP-SMOTE+ENN", "strategy": "SMOTE+ENN", "rf_method": "SMOTE+ENN"}
  ],
  "figure_dpi": 300,
  "figure_font": "Microsoft YaHei",
  "note": "No architecture search. Seven prespecified sampling/weighting variants. All 35 checkpoints and validation thresholds are frozen before any neural test scoring. Original RF and unsupervised results are preserved."
}
